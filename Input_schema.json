{
   "do-nmap": {
      "type": "object",
      "properties": {
         "target": {
            "type": "string",
            "description": "Target ip to detect open ports"
         },
         "nmap_args": {
            "anyOf": [
               {
                  "type": "string",
                  "description": "Nmap arguments as a string (e.g. '-p 80,443 -sV')"
               },
               {
                  "type": "array",
                  "items": {
                     "type": "string"
                  },
                  "description": "Nmap arguments as an array (e.g. ['-p', '80,443', '-sV'])"
               }
            ]
         }
      },
      "required": [
         "target",
         "nmap_args"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "do-sqlmap": {
      "type": "object",
      "properties": {
         "url": {
            "type": "string",
            "format": "uri",
            "description": "Target URL to detect SQL Injection"
         },
         "sqlmap_args": {
            "anyOf": [
               {
                  "type": "string",
                  "description": "SQLMap arguments as a string (e.g. '--batch --dbs')"
               },
               {
                  "type": "array",
                  "items": {
                     "type": "string"
                  },
                  "description": "SQLMap arguments as an array (e.g. ['--batch', '--dbs'])"
               }
            ]
         }
      },
      "required": [
         "url",
         "sqlmap_args"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "do-ffuf": {
      "type": "object",
      "properties": {
         "url": {
            "type": "string",
            "format": "uri",
            "description": "Target URL to fuzz"
         },
         "ffuf_args": {
            "anyOf": [
               {
                  "type": "string",
                  "description": "FFUF arguments as a string (e.g. '-w wordlist.txt:FUZZ -c')"
               },
               {
                  "type": "array",
                  "items": {
                     "type": "string"
                  },
                  "description": "FFUF arguments as an array (e.g. ['-w', 'wordlist.txt:FUZZ', '-c'])"
               }
            ]
         }
      },
      "required": [
         "url",
         "ffuf_args"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "do-masscan": {
      "type": "object",
      "properties": {
         "target": {
            "type": "string",
            "description": "Target information. Example: 1.1.1.1\n            1.1.1.1\n            "
         },
         "port": {
            "type": "string",
            "description": "Target port. Example: 1234\n               0-65535\n                "
         },
         "masscan_args": {
            "anyOf": [
               {
                  "type": "string",
                  "description": "Masscan arguments as a string (e.g. '--max-rate 100 --wait 0')"
               },
               {
                  "type": "array",
                  "items": {
                     "type": "string"
                  },
                  "description": "Masscan arguments as an array (e.g. ['--max-rate', '100', '--wait', '0'])"
               }
            ]
         }
      },
      "required": [
         "target",
         "port",
         "masscan_args"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "do-sslscan": {
      "type": "object",
      "properties": {
         "target": {
            "type": "string",
            "format": "uri",
            "description": "Target URL to scan (must begin with https:// for proper SSL/TLS scanning)"
         },
         "sslscan_args": {
            "anyOf": [
               {
                  "type": "string",
                  "description": "SSLScan arguments as a string (e.g. '--no-heartbleed --show-certificate')"
               },
               {
                  "type": "array",
                  "items": {
                     "type": "string"
                  },
                  "description": "SSLScan arguments as an array (e.g. ['--no-heartbleed', '--show-certificate'])"
               }
            ]
         }
      },
      "required": [
         "target",
         "sslscan_args"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
   }
}